{
  "credit": "after @dbworku",
  "burst": {
    "label": "burst compute",
    "headline": "More CPU and memory when the step needs it.",
    "seconds": 12,
    "cols": 56,
    "cpu": { "base": 4, "max": 5 },
    "mem": { "base": 16 },
    "steps": [
      { "name": "setup",   "from": 0,  "to": 10, "cpu": 0.30, "mem": 0.25 },
      { "name": "compile", "from": 10, "to": 28, "cpu": 1.10, "mem": 0.55 },
      { "name": "test",    "from": 28, "to": 46, "cpu": 0.70, "mem": 1.15 },
      { "name": "upload",  "from": 46, "to": 56, "cpu": 0.20, "mem": 0.30 }
    ],
    "bursts": [ { "at": 15, "cpu": 1 }, { "at": 33, "mem": 8 } ]
  },
  "router": {
    "label": "job router",
    "headline": "Every job runs where it finishes fastest.",
    "seconds": 12,
    "jobs": ["diff", "build", "unit tests", "integration", "e2e tests", "publish"],
    "providers": [
      { "name": "A", "cost": [1.0, 2.2, 1.4, 2.0, 1.1, 2.4], "down": [5.0, 9.5] },
      { "name": "B", "cost": [1.8, 0.9, 2.1, 1.2, 2.0, 1.0] },
      { "name": "C", "cost": [1.2, 1.6, 0.8, 2.3, 1.0, 1.9], "down": [5.6, 9.5] },
      { "name": "D", "cost": [2.4, 1.3, 1.9, 0.9, 1.7, 1.3] }
    ],
    "e2e": [27, 15],
    "telemetry": [
      { "name": "start time", "unit": "s",  "value": [2.1, 3.6], "dp": 1, "spikes": true, "outage": 1 },
      { "name": "network",       "unit": "ms", "value": [38, 52],  "outage": 0.5 },
      { "name": "variance",      "unit": "%",  "value": [3, 9],    "outage": 1 }
    ]
  }
}
